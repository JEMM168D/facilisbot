{
  "name": "yunque-bots",
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma autónoma, auto-hospedada y altamente personalizable de Chatbots de IA multicanal para empresas",
  "main": "src/server/index.js",
  "bin": {
    "yunque": "bin/yunque.js",
    "forjabot": "bin/yunque.js"
  },
  "scripts": {
    "dev": "node bin/yunque.js serve",
    "start": "node src/server/index.js",
    "init": "node bin/yunque.js init",
    "doctor": "node bin/yunque.js doctor",
    "list": "node bin/yunque.js list",
    "backup": "node bin/yunque.js backup",
    "update": "node bin/yunque.js update",
    "deploy": "npx wrangler deploy src/worker.js",
    "test": "node test/verify.js"
  },
  "keywords": [
    "chatbot",
    "ai",
    "whatsapp",
    "telegram",
    "instagram",
    "cloudflare-workers",
    "self-hosted",
    "gemini",
    "claude",
    "openai"
  ],
  "author": "Yunque Bots",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
