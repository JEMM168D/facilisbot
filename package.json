{
  "name": "facilisbot",
  "version": "1.0.0",
  "type": "module",
  "description": "FacilisBot - Plataforma autónoma, auto-hospedada y altamente personalizable de Chatbots de IA multicanal para empresas con Gemini 3.5 Flash Lite",
  "main": "src/server/index.js",
  "bin": {
    "facilisbot": "bin/facilisbot.js",
    "facilis": "bin/facilisbot.js",
    "yunque": "bin/facilisbot.js",
    "forjabot": "bin/facilisbot.js"
  },
  "scripts": {
    "dev": "node bin/facilisbot.js serve",
    "start": "node src/server/index.js",
    "init": "node bin/facilisbot.js init",
    "doctor": "node bin/facilisbot.js doctor",
    "list": "node bin/facilisbot.js list",
    "backup": "node bin/facilisbot.js backup",
    "update": "node bin/facilisbot.js update",
    "deploy": "npx wrangler deploy src/worker.js",
    "test": "node test/verify.js"
  },
  "keywords": [
    "facilisbot",
    "chatbot",
    "ai",
    "whatsapp",
    "telegram",
    "instagram",
    "cloudflare-workers",
    "self-hosted",
    "gemini",
    "claude",
    "openai"
  ],
  "author": "FacilisBot",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
