name = "yunque-chatbot"
main = "src/server/index.js"
compatibility_date = "2024-09-23"

# Variables públicas
[vars]
BOT_NAME = "Asistente Virtual"
BOT_NICHE = "starter"
BASE_URL = "https://tu-bot.workers.dev"

# Secretos (se configuran con: wrangler secret put <NOMBRE>)
# ANTHROPIC_API_KEY
# GEMINI_API_KEY
# OPENAI_API_KEY
# TELEGRAM_BOT_TOKEN
# WHATSAPP_TOKEN
# ADMIN_PASSWORD
